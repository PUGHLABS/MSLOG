rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Members collection
    // - Any authenticated user can read (for directory)
    // - Users can create their own document (registration)
    // - Users can update their own document (profile edits)
    // - Admins can update any member (approve/reject, role changes)
    // - Only admins can delete members
    match /members/{memberId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == memberId;
      allow update: if isAuth() && (request.auth.uid == memberId || isAdmin());
      allow delete: if isAdmin();
    }

    // Parcel registry (official county landowner data) - admin only
    match /parcels/{parcelId} {
      allow read, write: if isAdmin();
    }

    // County-recorded parcel sales (written only by Cloud Functions via Admin SDK)
    match /parcel_sales/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contact messages - anyone can create (public form), only admin can read/update/delete
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Announcements - authenticated users can read, only admin can write
    match /announcements/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Events - authenticated users can read, only admin can write
    match /events/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Forum (legacy collection) - authenticated users can read and write
    match /forum/{docId} {
      allow read, write: if isAuth();
    }
    match /forum/{threadId}/replies/{replyId} {
      allow read, write: if isAuth();
    }

    // Settings (gate codes) - authenticated users can read, only admin can write
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Analytics - authenticated users can increment counters, only admin can read
    match /settings/analytics {
      allow read: if isAdmin();
      allow update: if isAuth();
      allow create: if isAuth();
    }

    // Documents - authenticated users can read, only admin can write
    match /documents/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Videos - authenticated users can read, only admin can write
    match /videos/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // For Sale listings - members can read, only admin can write
    match /listings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Polls - authenticated users can read and vote, only admin can create/delete/close
    match /polls/{pollId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAuth();  // members update votes map; admins close polls
      allow delete: if isAdmin();
    }

    // Threads (Forum) - authenticated users can read
    // Members can create threads, authors and admins can delete
    match /threads/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    match /threads/{threadId}/replies/{replyId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
