rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /forum-images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /documents/{fileName} {
      // Authenticated users can read (download PDFs)
      allow read: if request.auth != null;
      // Authenticated users can upload PDFs (max 10MB); admin enforcement is in Firestore rules
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      // Authenticated users can delete files; admin enforcement is in the app layer
      allow delete: if request.auth != null;
    }
    match /photos/{fileName} {
      // Authenticated users can view gallery photos
      allow read: if request.auth != null;
      // Authenticated users can upload images (max 10MB); admin enforcement is in Firestore rules (photos collection)
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Authenticated users can delete files; admin enforcement is in the app layer
      allow delete: if request.auth != null;
    }
  }
}
